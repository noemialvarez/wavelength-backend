PORT=3001

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Phantombuster
PHANTOMBUSTER_API_KEY=your-phantombuster-api-key
PHANTOMBUSTER_SALES_NAV_AGENT_ID=your-agent-id
PHANTOMBUSTER_LINKEDIN_AGENT_ID=your-agent-id
PHANTOMBUSTER_LINKEDIN_SEARCH_AGENT_ID=your-linkedin-search-agent-id
PHANTOMBUSTER_LINKEDIN_SESSION=your-li_at-cookie-value
# LinkedIn "Auto Connect" agent — required to send connection requests from
# Lead Discovery Option 3. Without this, by-name search still works but
# "Send connection request" returns a clear error instead of sending.
PHANTOMBUSTER_CONNECT_AGENT_ID=your-auto-connect-agent-id
# LinkedIn "Connections Export" agent — optional. Powers the acceptance-polling
# cron job that flips a lead to "connection accepted" once they accept.
# Without this, accepted connections must be marked manually
# (PATCH /api/leads/:id with { "linkedin_connection_status": "accepted",
# "linkedin_connection_accepted_at": "<ISO timestamp>" }).
PHANTOMBUSTER_CONNECTIONS_AGENT_ID=your-connections-export-agent-id
# LinkedIn "Message Sender" agent — required to send the post-connection
# outreach message and the 3-day-no-reply reminder. Lemlist is NOT used for
# LinkedIn sends (that needs their paid Multichannel tier) — this agent covers
# it within the existing Phantombuster plan instead.
PHANTOMBUSTER_MESSAGE_AGENT_ID=your-message-sender-agent-id

# Apollo.io (email enrichment after Phantombuster)
APOLLO_API_KEY=your-apollo-api-key

# Lemlist — email outreach only (see PHANTOMBUSTER_MESSAGE_AGENT_ID above for
# why LinkedIn sends don't go through Lemlist)
LEMLIST_API_KEY=your-lemlist-api-key

# CORS
FRONTEND_URL=https://wavelength-outreach.lovable.app
